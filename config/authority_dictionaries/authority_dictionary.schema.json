        "entity_type": {
          "enum": [
            "person",
            "organization",
            "place",
            "event",
            "work",
            "other"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "local_id": {
          "minLength": 1,
          "title": "Local Id",
          "type": "string"
        },
        "preferred_name": {
          "minLength": 1,
          "title": "Preferred Name",
          "type": "string"
        },
        "resolution": {
          "$ref": "#/$defs/AuthorityResolution"
        },
        "review_status": {
          "default": "unreviewed",
          "enum": [
            "unreviewed",
            "reviewed",
            "approved"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "source_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Note"
        },
        "temporal_expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal Expression"
        },
        "temporal_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal Note"
        }
      },
      "required": [
        "local_id",
        "entity_type",
        "preferred_name"
