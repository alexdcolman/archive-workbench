        "target_kind": {
          "default": "authority",
          "enum": [
            "authority",
            "archival_unit",
            "document_part"
          ],
          "title": "Target Kind",
          "type": "string"
        },
        "target_local_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Local Id"
        },
        "temporal_expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal Expression"
        },
        "temporal_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
