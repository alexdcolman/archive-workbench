    "dictionary_id": {
      "minLength": 1,
      "title": "Dictionary Id",
      "type": "string"
    },
    "dictionary_name": {
      "minLength": 1,
      "title": "Dictionary Name",
      "type": "string"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/DictionaryRelation"
      },
      "title": "Relations",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
