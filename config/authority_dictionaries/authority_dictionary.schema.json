{
  "$defs": {
    "AuthorityResolution": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": "auto",
          "enum": [
            "auto",
            "use_existing",
            "create_new",
            "skip"
          ],
          "title": "Action",
          "type": "string"
        },
        "authority_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authority Id"
        }
      },
      "title": "AuthorityResolution",
      "type": "object"
    },
    "DictionaryAlias": {
      "additionalProperties": false,
      "properties": {
        "alias_type": {
          "default": "variant",
          "enum": [
            "variant",
            "abbreviation",
            "acronym",
            "former_name",
            "title",
            "other"
          ],
          "title": "Alias Type",
          "type": "string"
        },
        "allow_ambiguous": {
          "default": false,
          "title": "Allow Ambiguous",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "DictionaryAlias",
      "type": "object"
    },
    "DictionaryAuthority": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "$ref": "#/$defs/DictionaryAlias"
          },
          "title": "Aliases",
          "type": "array"
        },
        "characteristics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "title": "Characteristics",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
