  "$id": "https://archive-workbench.local/schema/authority-dictionary-1.0.json",
  "additionalProperties": false,
  "properties": {
    "authorities": {
      "items": {
        "$ref": "#/$defs/DictionaryAuthority"
      },
      "title": "Authorities",
      "type": "array"
