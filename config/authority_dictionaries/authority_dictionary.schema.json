      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/DictionarySource"
    },
    "target_project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
